# Copy this file to .env and fill it in. Leave a value empty to use demo mode for that part.

# Discord Developer Portal -> your application -> General Information -> Application ID
# The application's NAME is what your profile shows ("Playing <name>"), so name it something cool.
DISCORD_CLIENT_ID=

# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Your 17-digit SteamID64 (find it at https://steamid.io)
STEAM_ID64=

# Optional: big image shown on Discord when you're not in a game.
# Either an Art Asset key uploaded under Rich Presence -> Art Assets, or an https:// image URL.
LARGE_IMAGE=

PORT=3000
